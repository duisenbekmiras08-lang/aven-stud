# 1) Copy this file to .env
# 2) Paste your own OpenAI API key after the equals sign on your computer.
# Do NOT send this key in chat or commit .env to Git.
OPENAI_API_KEY=

# Choose a model available to your API project. The server uses the Responses API.
OPENAI_MODEL=gpt-5.5

# Set a long random value before any public deployment.
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Leave 0 for localhost/LAN demo over HTTP. Use 1 only behind HTTPS.
COOKIE_SECURE=0
FLASK_DEBUG=0
PORT=5000
